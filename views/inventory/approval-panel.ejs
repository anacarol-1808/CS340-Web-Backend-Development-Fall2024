<% if (title) { %> 
  <h1><%= title %></h1>
<% } else {  
  res.redirect('/') 
} %>

<!-- message -->
<%- messages() %>

<% if (errors) { %>
  <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <% }) %>
  </ul>
<% } %>

<!-- Classifications Pending Approval Form -->
<% if (pendingClassifications && pendingClassifications.length > 0) { %>
  <% pendingClassifications.forEach(classification => { %>
    <form action="/inv/approval-panel-classification" method="post">
      <fieldset>
        <legend>Classifications Pending Approval</legend>

        <label for="classification_name">Classification Name:</label>
        <input type="text" id="classification_name" name="classification_name" value="<%= classification.classification_name %>" readonly>

        <label for="created_by">Created by (Original Submitter):</label>
        <input type="text" name="account_firstname" value="<%= classification.account_firstname || 'N/A' %>" readonly>
        <input type="text" name="account_lastname" value="<%= classification.account_lastname || 'N/A' %>" readonly>

        <label for="classification_creation_date">Creation date:</label>
        <input type="date" name="classification_creation_date" value="<%= new Date(classification.classification_creation_date).toISOString().split('T')[0] %>" readonly>

        <!-- Hidden field to identify classification form -->
        <input type="hidden" name="classification_id" value="<%= classification.classification_id %>"> 
        <input type="hidden" name="admin_account_id" value="<%= user.account_id %>">

        <!-- Approve and Reject buttons -->
        <button type="submit" name="action" value="approve" class="approve-btn">Approve</button>
        <button type="submit" name="action" value="reject" class="reject-btn">Reject</button>
      </fieldset>
    </form>
  <% }) %>
<% } else { %>
  <p>No classifications pending approval.</p>
<% } %>

<!-- Inventory Pending Approval Form -->
<% if (pendingInventory && pendingInventory.length > 0) { %>
  <% pendingInventory.forEach(inventory => { %>
    <form action="/inv/approval-panel-inventory" method="post">
      <fieldset>
        <legend>Inventory Pending Approval</legend>

        <label for="classification_name">Classification Name:</label>
        <input type="text" id="classification_name" name="classification_name" value="<%= inventory.classification_name %>" readonly>

        <label for="make">Make</label>
        <input type="text" id="make" name="inv_make" readonly value="<%= inventory.inv_make %>">

        <label for="model">Model</label>
        <input type="text" id="model" name="inv_model" readonly value="<%= inventory.inv_model %>">

        <label for="year">Year</label>
        <input type="number" id="year" name="inv_year" readonly value="<%= inventory.inv_year %>">

        <label for="description">Description</label>
        <input type="text" id="description" name="inv_description" readonly value="<%= inventory.inv_description %>">

        <label for="image">Image Path</label>
        <input type="text" id="imagePath" name="inv_image" readonly value="<%= inventory.inv_image %>">

        <label for="thumbnailPath">Thumbnail Path</label>
        <input type="text" id="thumbnailPath" name="inv_thumbnail" readonly value="<%= inventory.inv_thumbnail %>">

        <label for="price">Price</label>
        <input type="number" id="price" name="inv_price" readonly value="<%= inventory.inv_price %>">

        <label for="miles">Miles</label>
        <input type="number" id="miles" name="inv_miles" readonly value="<%= inventory.inv_miles %>">

        <label for="color">Color</label>
        <input type="text" id="color" name="inv_color" readonly value="<%= inventory.inv_color %>">

        <!-- Hidden field to identify inventory form -->
        <input type="hidden" name="inv_id" value="<%= inventory.inv_id %>">
        <input type="hidden" name="admin_account_id" value="<%= user.account_id %>">

        <!-- Approve and Reject buttons -->
        <button type="submit" name="action" value="approve" class="approve-btn">Approve</button>
        <button type="submit" name="action" value="reject" class="reject-btn">Reject</button>
      </fieldset>
    </form>
  <% }) %>
<% } else { %>
  <p>No inventory items pending approval.</p>
<% } %>
